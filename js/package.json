{
    "name": "@flectar/flarum-turnstile",
    "private": true,
    "version": "0.0.0",
    "devDependencies": {
        "@flarum/prettier-config": "^1.0.0",
        "cross-env": "^10.1.0",
        "flarum-tsconfig": "^2.0.0",
        "flarum-webpack-config": "^3.0.7",
        "jsdom": "^27.0.0",
        "prettier": "^3.5.3",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5",
        "webpack": "^5.99.7",
        "webpack-cli": "^6.0.1"
    },
    "scripts": {
        "dev": "webpack --mode development --watch",
        "build": "webpack --mode production",
        "analyze": "cross-env ANALYZER=true npm run build",
        "format": "prettier --write src tests vitest.config.mts",
        "format-check": "prettier --check src tests vitest.config.mts",
        "check-typings": "tsc --noEmit",
        "test": "vitest run"
    },
    "prettier": "@flarum/prettier-config",
    "engines": {
        "node": ">=24"
    }
}
